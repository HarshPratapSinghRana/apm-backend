nsform:translateY(-50%)}.copilot-custom-card{background:var(--surface-card, #fff);border:1px solid var(--border-light, #e5e7eb);border-radius:12px;padding:24px 28px;margin-bottom:16px}.copilot-custom-card h4{font-size:16px;font-weight:700;color:var(--text-primary, #111827);margin:0 0 14px}.copilot-custom-card .sdd-bullet-list{gap:6px}.copilot-custom-card .sdd-bullet-list li{font-size:14px}.copilot-custom-card .sdd-code-block{margin-top:14px}.copilot-subsection-title{font-size:14px;font-weight:700;color:var(--text-primary, #111827);margin:20px 0 10px}.copilot-modes-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:14px}.copilot-mode-card{background:var(--surface-card-hover, #f9fafb);border:1px solid var(--border-light, #e5e7eb);border-radius:8px;padding:16px 18px}.copilot-mode-card strong{display:block;font-size:13px;font-weight:700;color:var(--text-primary, #111827);margin-bottom:4px}.copilot-mode-card span{font-size:12.5px;color:var(--text-tertiary, #6b7280);line-height:1.5}.copilot-flow-bar{background:color-mix(in srgb,var(--accent, #b91c1c) 6%,transparent);border:1px solid color-mix(in srgb,var(--accent, #b91c1c) 15%,transparent);border-radius:8px;padding:12px 20px;font-size:13px;color:var(--accent, #b91c1c);line-height:1.5;margin:12px 0 16px}.copilot-flow-bar strong{font-weight:700}@media (max-width: 768px){.copilot-features-diagram{flex:none;width:100%}.copilot-modes-grid{grid-template-columns:1fr}}.copilot-scenarios-section{display:flex;flex-direction:column;gap:8px;animation:fluentFadeIn .35s cubic-bezier(.22,1,.36,1)}.copilot-scenarios-section>.sdd-section-title{margin-bottom:0}.copilot-scenarios-section>.sdd-text{margin-bottom:8px}.sdd-scenarios-split{display:flex;gap:20px;align-items:flex-start}.sdd-scenarios-col{flex:1;min-width:0;display:flex;flex-direction:column;gap:8px}@media (max-width: 900px){.sdd-scenarios-split{flex-direction:column}}.copilot-scenario-accordion{border:1px solid var(--border-light, #e5e7eb);border-radius:10px;overflow:hidden;transition:border-color .2s ease}.copilot-scenario-accordion.open{border-color:color-mix(in srgb,var(--accent, #b91c1c) 25%,transparent)}.copilot-scenario-header{width:100%;display:flex;justify-content:space-between;align-items:center;padding:14px 20px;background:var(--surface-card, #fff);border:none;cursor:pointer;font-size:14px;color:var(--text-primary, #111827);text-align:left;transition:background .15s ease}.copilot-scenario-header:hover{background:var(--surface-card-hover, #f9fafb)}.copilot-scenario-header strong{color:var(--text-tertiary, #6b7280);margin-right:10px;font-weight:600}.copilot-accordion-arrow{font-size:14px;color:var(--text-tertiary, #6b7280);flex-shrink:0}.copilot-scenario-body{padding:0 24px 20px;animation:fluentFadeIn .25s cubic-bezier(.22,1,.36,1)}.copilot-scenario-body>p{font-size:14px;line-height:1.6;color:var(--text-secondary, #374151);margin:0 0 14px}.copilot-scenario-body h5{font-size:13px;font-weight:700;color:var(--text-primary, #111827);margin:14px 0 8px}.copilot-scenario-body ul{list-style:disc;padding-left:20px;margin:0 0 6px;display:flex;flex-direction:column;gap:4px}.copilot-scenario-body ul li{font-size:13.5px;line-height:1.5;color:var(--text-secondary, #374151)}.copilot-prompt-outcome{background:var(--surface-card-hover, #f9fafb);border:1px solid var(--border-light, #e5e7eb);border-radius:8px;padding:14px 18px;margin-bottom:10px}.copilot-prompt-outcome p{font-size:13.5px;line-height:1.55;color:var(--text-secondary, #374151);margin:0 0 4px}.copilot-prompt-outcome p:last-child{margin-bottom:0}.copilot-prompt-outcome em{color:var(--text-primary, #111827)}.sdd-wheel{display:grid;grid-template-columns:1fr 1fr;grid-template-rows:auto auto auto;gap:16px;max-width:700px;width:100%}.sdd-wheel-item{background:var(--surface-card, #fff);border:1px solid var(--border-light, #e5e7eb);border-radius:12px;padding:20px;text-align:center;transition:box-shadow .2s ease,border-color .2s ease}.sdd-wheel-item:hover{border-color:color-mix(in srgb,var(--accent, #b91c1c) 30%,transparent);box-shadow:0 4px 12px #0000000f}.sdd-wheel-item strong{display:block;font-size:14px;font-weight:700;color:var(--text-primary, #111827);margin-bottom:6px}.sdd-wheel-item span{font-size:13px;color:var(--text-tertiary, #6b7280);line-height:1.5}.sdd-wheel-bottom{grid-column:1 / -1;max-width:50%;justify-self:center}.sdd-code-block{background:var(--surface-card-hover, #f3f4f6);border:1px solid var(--border-light, #e5e7eb);border-radius:10px;padding:20px 24px;font-family:Monaco,Courier New,monospace;font-size:13px;line-height:1.8;color:var(--text-secondary, #374151);overflow-x:auto;margin:0;white-space:pre}.sdd-step-card{background:var(--surface-card, #fff);border:1px solid var(--border-light, #e5e7eb);border-radius:10px;padding:20px 24px;margin-bottom:12px}.sdd-step-header{font-size:14px;font-weight:600;color:var(--text-primary, #111827);margin-bottom:12px}.sdd-code-inline{background:var(--surface-card-hover, #f3f4f6);border:1px solid var(--border-light, #e5e7eb);border-radius:6px;padding:10px 16px;font-family:Monaco,Courier New,monospace;font-size:13px;line-height:1.7;color:var(--text-secondary, #374151);margin:0;white-space:pre;overflow-x:auto}.sdd-table-wrapper{overflow-x:auto;border-radius:10px;border:1px solid var(--border-light, #e5e7eb)}.sdd-table{width:100%;border-collapse:collapse;font-size:14px}.sdd-table thead{background:var(--surface-card-hover, #f3f4f6)}.sdd-table th{text-align:left;padding:14px 20px;font-weight:700;color:var(--text-primary, #111827);font-size:13px;letter-spacing:.02em;border-bottom:1px solid var(--border-light, #e5e7eb)}.sdd-table td{padding:14px 20px;color:var(--text-secondary, #374151);border-bottom:1px solid var(--border-light, #e5e7eb);line-height:1.5;vertical-align:top}.sdd-table tbody tr:last-child td{border-bottom:none}.sdd-table tbody tr:hover{background:color-mix(in srgb,var(--accent, #b91c1c) 3%,transparent)}.sdd-req-table thead{background:#1a1a1a}.sdd-req-table thead th{color:#fff;font-weight:700}.sdd-req-table td:first-child{font-weight:600;white-space:nowrap}.sdd-table code{background:color-mix(in srgb,var(--accent, #b91c1c) 8%,transparent);color:var(--accent, #b91c1c);padding:3px 8px;border-radius:4px;font-size:12.5px;font-family:Monaco,Courier New,monospace;font-weight:500;white-space:nowrap}@media (max-width: 768px){.sdd-intro-section{flex-direction:column}.sdd-intro-right{flex:none;width:100%}.sdd-wheel{grid-template-columns:1fr}.sdd-wheel-bottom{max-width:100%}}\n"

          "content": {
            "size": 96457,
            "mimeType": "text/css",
            "compression": -180,
            "text": ":root{--bg-primary: #ffffff;--bg-secondary: #fafbfc;--bg-tertiary: #f3f4f6;--bg-landing: #f8f9fa;--bg-header: #ffffff;--bg-card: #ffffff;--bg-input: #ffffff;--bg-modal: #ffffff;--bg-modal-body: #fafbfc;--bg-section: #fafbfc;--bg-table-even: #fafbfc;--bg-table-odd: #ffffff;--bg-table-hover: #f9fafb;--bg-thead: #1f2937;--bg-badge: #f3f4f6;--bg-code: #f3f4f6;--bg-filter-group: #f3f4f6;--text-primary: #111827;--text-secondary: #374151;--text-tertiary: #6b7280;--text-muted: #9ca3af;--text-heading: #1f2937;--text-table: #374151;--text-thead: #ffffff;--border-primary: #e5e7eb;--border-secondary: #d1d5db;--border-subtle: #f3f4f6;--shadow-sm: 0 1px 3px 0 rgba(0, 0, 0, .05);--shadow-md: 0 4px 12px rgba(0, 0, 0, .1);--shadow-lg: 0 25px 50px -12px rgba(0, 0, 0, .25);--shadow-header: 0 1px 3px 0 rgba(0, 0, 0, .05);--accent: #C71518;--accent-secondary: #f8bfbf;--donut-color: #c71518;--donut-secondary: #82e082;--donut-background: #e6f7e6;--accent-hover: #a01215;--accent-shadow: rgba(199, 21, 24, .2);--scrollbar-track: #f9fafb;--scrollbar-thumb: #d1d5db;--scrollbar-hover: #9ca3af;--logo-filter: none}html{scroll-behavior:smooth;scrollbar-gutter:stable;overflow-y:scroll}*{margin:0;padding:0;box-sizing:border-box}body{font-family:Inter,Segoe UI,-apple-system,BlinkMacSystemFont,sans-serif;background:var(--bg-secondary);min-height:100vh;padding:0;color:var(--text-heading);line-height:1.6;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;transition:background-color .3s ease,color .3s ease}.page-transition{animation:pageFadeIn .3s cubic-bezier(.22,1,.36,1)}@keyframes pageFadeIn{0%{opacity:0}to{opacity:1}}.app-container{max-width:100%;margin:0;background:var(--bg-primary);box-shadow:none;padding:0;min-height:100vh}.header{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:16px 48px;background:var(--bg-header);border-bottom:1px solid var(--border-primary);box-shadow:var(--shadow-header)}.app-heading{color:var(--text-primary);font-size:1.575rem;font-weight:500;letter-spacing:-.025em;font-family:Inter,sans-serif;margin:0 0 0 auto}.breadcrumb{display:flex;align-items:center;gap:0;font-size:.875rem;font-family:Inter,sans-serif;flex-shrink:0}.breadcrumb-link{color:var(--text-tertiary);cursor:pointer;transition:color .15s ease;font-weight:500}.breadcrumb-link:hover{color:var(--accent);text-decoration:underline}.breadcrumb-sep{color:var(--text-muted);margin:0 8px;font-weight:400;-webkit-user-select:none;user-select:none}.breadcrumb-current{color:var(--text-primary);font-weight:600}@media (max-width: 768px){.breadcrumb{font-size:.75rem}.breadcrumb-sep{margin:0 5px}}@media (max-width: 1024px){.header{padding:16px 24px}}@media (max-width: 768px){.header{padding:12px 16px;gap:12px}}.logo{height:20px;width:auto;filter:var(--logo-filter)}.button-container{display:flex;gap:12px;justify-content:flex-start;flex-wrap:wrap;padding:32px 48px 24px;background:var(--bg-primary);border-bottom:2px solid var(--border-primary);position:relative}@media (max-width: 1024px){.button-container{padding:24px 24px 16px;gap:10px;overflow-x:auto;overflow-y:hidden;flex-wrap:nowrap;-webkit-overflow-scrolling:touch;scrollbar-width:thin}.button-container::-webkit-scrollbar{height:6px}.button-container::-webkit-scrollbar-track{background:#e5e7eb;border-radius:3px}.button-container::-webkit-scrollbar-thumb{background:#9ca3af;border-radius:3px}.button-container:after{content:\"→\";position:absolute;right:10px;top:50%;transform:translateY(-50%);font-size:1.25rem;color:#9ca3af;pointer-events:none;z-index:1;opacity:.6;animation:slideHint 1.5s ease-in-out infinite}@keyframes slideHint{0%,to{transform:translateY(-50%) translate(0)}50%{transform:translateY(-50%) translate(4px)}}}@media (max-width: 768px){.button-container{padding:16px 16px 24px;gap:8px}.button-container:before{content:\"Swipe to navigate →\";position:absolute;bottom:6px;left:50%;transform:translate(-50%);font-size:.688rem;color:#9ca3af;font-weight:500;pointer-events:none;opacity:.9;font-family:Inter,sans-serif}}.btn{padding:10px 20px;font-size:.875rem;font-weight:500;border:1px solid var(--border-secondary);background:var(--bg-primary);color:var(--text-secondary);border-radius:6px;cursor:pointer;transition:all .15s ease;font-family:Inter,sans-serif;letter-spacing:-.01em;white-space:nowrap;flex-shrink:0}.btn:hover{background:var(--bg-tertiary);border-color:var(--border-secondary);color:var(--text-primary)}.btn.active{background:var(--accent);color:#fff;border-color:var(--accent);box-shadow:0 2px 4px 0 var(--accent-shadow);font-weight:600}.btn.active:hover{background:var(--accent-hover);border-color:var(--accent-hover)}.btn-back-arrow{display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;padding:0;border-radius:50%;background:var(--bg-primary);border:1px solid var(--border-secondary);color:var(--text-secondary);cursor:pointer;transition:all .15s ease;flex-shrink:0}.btn-back-arrow:hover{background:var(--bg-tertiary);color:var(--accent);border-color:var(--accent)}.btn-view-details{margin-left:auto}@media (min-width: 1025px) and (max-width: 1440px){.button-container{padding:24px 24px 16px;gap:10px;overflow-x:auto;overflow-y:hidden;flex-wrap:nowrap;-webkit-overflow-scrolling:touch;scrollbar-width:thin}.button-container::-webkit-scrollbar{height:6px}.button-container::-webkit-scrollbar-track{background:#e5e7eb;border-radius:3px}.button-container::-webkit-scrollbar-thumb{background:#9ca3af;border-radius:3px}.btn{padding:9px 16px;font-size:.813rem}.btn-view-details{margin-left:auto}}@media (max-width: 1024px){.btn-view-details{margin-left:0}}.table-container{background:var(--bg-primary);padding:32px 48px 24px;border:none;min-height:calc(100vh - 200px)}@media (max-width: 1024px){.table-container{padding:24px}}@media (max-width: 768px){.table-container{padding:16px}}.table-wrapper{height:calc(100vh - 264px);overflow-y:auto;overflow-x:auto;border:1px solid var(--border-primary);border-radius:8px;box-shadow:v
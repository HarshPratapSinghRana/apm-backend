able tbody tr.user-story-first-row>td{border-top:2px solid var(--border-secondary)}.technology-container{display:flex;flex-wrap:wrap;gap:4px;align-items:center}.technology-badge{display:inline-block;padding:4px 8px;background:var(--bg-badge);color:var(--text-secondary);font-size:.75rem;font-weight:500;border-radius:12px;border:1px solid var(--border-primary);white-space:nowrap;line-height:1.2}.data-table thead{background:var(--bg-thead);color:var(--text-thead);position:sticky;top:0;z-index:10}.data-table th{padding:12px 16px;text-align:left;font-weight:600;font-size:.75rem;letter-spacing:.03em;white-space:nowrap;font-family:Inter,sans-serif}.data-table tbody tr{border-bottom:1px solid var(--border-subtle);transition:background-color .1s ease}.data-table tbody tr:hover{background-color:var(--bg-table-hover)}.data-table tbody tr:last-child{border-bottom:none}.data-table td{padding:12px 16px;color:var(--text-table);font-size:.875rem;word-wrap:break-word;overflow-wrap:break-word;font-family:Inter,sans-serif;line-height:1.5;vertical-align:middle}.data-table tbody tr:nth-child(2n){background-color:var(--bg-table-even)}@media (max-width: 1024px){.app-heading{font-size:1.25rem}.btn{padding:8px 16px;font-size:.813rem}.data-table th,.data-table td{padding:10px 12px;font-size:.813rem}}@media (max-width: 768px){.app-container{padding:0}.logo{height:18px}.app-heading{font-size:1.125rem}.btn{padding:8px 14px;font-size:.75rem}.table-title{font-size:1.125rem;margin-bottom:16px}.data-table{font-size:.813rem}.data-table th,.data-table td{padding:8px 10px;font-size:.75rem}.data-table th{white-space:nowrap}}@media (max-width: 480px){.logo{height:16px}.app-heading{font-size:.938rem}.btn{padding:7px 12px;font-size:.688rem}.table-title{font-size:1rem}.data-table th,.data-table td{padding:6px 8px;font-size:.688rem}}.table-header-row{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:16px}.table-toolbar{display:flex;align-items:center;gap:16px;margin-bottom
}.fluent-hero-title{font-size:3.75rem;font-weight:700;color:var(--text-heading);font-family:Inter,Segoe UI,-apple-system,BlinkMacSystemFont,sans-serif;letter-spacing:-.025em;line-height:1.15;margin-bottom:16px}.fluent-hero-subtitle{font-size:1.35rem;font-weight:400;color:var(--text-tertiary);max-width:720px;margin:0 auto;line-height:1.6}.fluent-hero-rule{width:48px;height:3px;background:var(--accent);margin:28px auto 0;border-radius:2px}.fluent-pivot-bar{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:16px 24px;background:var(--bg-primary);border-bottom:none;position:sticky;top:53px;z-index:90}.fluent-pivot-spacer{display:block}.fluent-pivot{display:flex;gap:10px;background:transparent;border-radius:0;padding:0}.fluent-pivot-item{position:relative;padding:10px 32px;font-size:14.5px;font-weight:500;color:var(--text-secondary);background:var(--bg-card);border:1.5px solid var(--border-primary);border-radius:8px;cursor:pointer;transition:color .18s,background .18s,border-color .18s,box-shadow .18s;font-family:inherit;white-space:nowrap;letter-spacing:.01em}.fluent-pivot-item:hover{color:var(--accent);border-color:var(--accent);background:var(--bg-secondary)}.fluent-pivot-item.selected{color:#fff;background:var(--accent);border-color:var(--accent);font-weight:600;box-shadow:0 4px 12px #c7151840}.fluent-pivot-item.selected:after{display:none}.fluent-main{flex:1;padding:28px 36px 56px;max-width:1600px;width:100%;margin:0 auto}.fluent-card-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-bottom:28px;animation:fluentSlideUp .4s cubic-bezier(.22,1,.36,1)}.fluent-overview-card{background:var(--bg-card);border:1px solid var(--border-primary);border-radius:12px;padding:32px 28px 28px;display:flex;flex-direction:column;gap:0;transition:border-color .2s,box-shadow .2s;cursor:default}.fluent-overview-card:hover{border-color:var(--border-secondary);box-shadow:var(--shadow-md)}.fluent-overview-card-icon{display:flex;align-items:center;j
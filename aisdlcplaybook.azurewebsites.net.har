            "text": "{\n  \"101\": {\n    \"title\": \"Architecture\",\n    \"columns\": [\n      \"User Story Category\",\n      \"Task Id\",\n      \"Task\",\n      \"Can it be done using Automation/Copilot?\",\n      \"Comments\",\n      \"Technology\",\n      \"Tools\",\n      \"How to Do?\",\n      \"Story Points\"\n    ],\n    \"userStories\": [\n      {\n        \"title\": \"Define data lakehouse & medallion architecture\",\n        \"taskIds\": [\n          1\n        ]\n      },\n      {\n        \"title\": \"Define workspace & environment architecture\",\n        \"taskIds\": [\n          2,\n          10\n        ]\n      },\n      {\n        \"title\": \"Define semantic model & data modeling strategy\",\n        \"taskIds\": [\n          3\n        ]\n      },\n      {\n        \"title\": \"Define capacity planning, cost & optimization strategy\",\n        \"taskIds\": [\n          4,\n          5,\n          7,\n          9\n        ]\n      },\n      {\n        \"title\": \"Conduct architecture review & stakeholder alignment\",\n        \"taskIds\": [\n          6\n        ]\n      },\n      {\n        \"title\": \"Define disaster recovery & business continuity architecture\",\n        \"taskIds\": [\n          8\n        ]\n      },\n      {\n        \"title\": \"Define observability, monitoring & data quality framework\",\n        \"taskIds\": [\n          11,\n          12\n        ]\n      },\n      {\n        \"title\": \"Define multi-workload separation strategy\",\n        \"taskIds\": [\n          13\n        ]\n      },\n      {\n        \"title\": \"Define notebook standardization architecture\",\n        \"taskIds\": [\n          14\n        ]\n      },\n      {\n        \"title\": \"Define configuration & secrets architecture\",\n        \"taskIds\": [\n          15\n        ]\n      },\n      {\n        \"title\": \"Define security, identity & access architecture\",\n        \"taskIds\": [\n          16\n        ]\n      },\n      {\n        \"title\": \"Define cube / semantic processing architecture\",\n        \"taskIds\": [\n          17\n        ]\n      },\n      {\n        \"title\": \"Define reporting consumption & access architecture\",\n        \"taskIds\": [\n          18\n        ]\n      },\n      {\n        \"title\": \"Define end‑to‑end security propagation architecture\",\n        \"taskIds\": [\n          19\n        ]\n      },\n      {\n        \"title\": \"Define transformation & business logic layering architecture\",\n        \"taskIds\": [\n          20\n        ]\n      }\n    ],\n    \"rows\": [\n      [\n        \"\",\n        1,\n        \"Define data lakehouse architecture (medallion - bronze/silver/gold layers)\",\n        \"Partial\",\n        \"Copilot generates architecture diagrams & recommendations\",\n        \"Databricks, Fabric, Synapse\",\n        \"GitHub Copilot\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        2,\n        \"Design workspace architecture for Fabric (workspace per environment vs shared)\",\n        \"Yes\",\n        \"Copilot provides recommendations\",\n        \"Fabric\",\n        \"GitHub Copilot\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        3,\n        \"Define Semantic model architecture and data modeling strategy\",\n        \"Partial\",\n        \"Copilot suggests star/snowflake schema\",\n        \"Power BI, Fabric\",\n        \"\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        4,\n        \"Analyze capacity planning for Fabric / Power BI\",\n        \"Partial\",\n        \"\",\n        \"Power BI, Fabric\",\n        \"\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        5,\n        \"Define cost budget and optimization constraints\",\n        \"No\",\n        \"Requires business decision\",\n        \"Fabric, Synapse, Databricks, Power BI\",\n        \"\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        6,\n        \"Conduct architecture review sessions with stakeholders\",\n        \"No\",\n        \"Requires business decission Making\",\n        \"Fabric, Synapse, Databricks, Power BI, ADF\",\n        \"\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        7,\n        \"Define trade-offs between performance, cost, and complexity\",\n        \"Partial\",\n        \"Copilot provides general costing and performation estimates but business judgement is required.\",\n        \"Fabric, Synapse, Databricks, Power BI, ADF\",\n        \"GitHub Copilot\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        8,\n        \"Define disaster recovery and business continuity architecture\",\n        \"Partial\",\n        \"Copilot provides data recovery strategy based on businees context\",\n        \"Fabric, Synapse, Databricks, Power BI, ADF\",\n        \"GitHub Copilot\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        9,\n        \"Design compute vs storage separation strategy\",\n        \"Partial\",\n        \"Copilot provides compute vs. storage separation strategy based on infrastructure and workload context.\",\n        \"Databricks, Fabric, Synapse\",\n        \"GitHub Copilot\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        10,\n        \"Design cross-workspace sharing and collaboration patterns\",\n        \"Partial\",\n        \"Copilot provides cross-workspace sharing and collaboration strategies based on organizational structure, toolset, and governance requirements.\",\n        \"Databricks, Fabric, Synapse\",\n        \"GitHub Copilot\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        11,\n        \"Design observability and monitoring architecture\",\n        \"Partial\",\n        \"\",\n        \"Databricks, Fabric, Synapse, ADF\",\n        \"\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        12,\n        \"Define data quality and validation framework architecture\",\n        \"Partial\",\n        \"\",\n        \"Databricks, Fabric, Synapse\",\n        \"\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        13,\n        \"Define what belongs in Lakehouse vs Warehouse vs Eventhouse and separation rules per domain\",\n        \"Partial\",\n        \"Copilot can generate decision criteria doc; architects finalize\",\n        \"Fabric Workloads\",\n        \"GitHub Copilot\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        14,\n        \"Define common notebook structure, naming, and execution standards\",\n        \"Partial\",\n        \"Copilot can generate notebook templates\",\n        \"Fabric, Databricks, Synapse Notebooks\",\n        \"GitHub Copilot\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        15,\n        \"Define how configs and secrets are managed consistently\",\n        \"Partial\",\n        \"Copilot can document config patterns\",\n        \"Key Vault, Fabric, Databricks, Synapse\",\n        \"\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        16,\n        \"Define authentication, authorization, and access control model\",\n        \"Partial\",\n        \"Copilot can draft access models and matrices; approval requires security owners\",\n        \"\",\n        \"GitHub Copilot\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        17,\n        \"Define processing modes, refresh sequencing, and dependency order\",\n        \"Partial\",\n        \"Copilot can draft refresh dependency flows\",\n        \"Semantic Models, Cube\",\n        \"\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        18,\n        \"Define how reports, dashboards, and ad‑hoc queries consume data\",\n        \"Partial\",\n        \"Copilot can document consumption patterns\",\n        \"BI Tools, SQL Endpoints\",\n        \"GitHub Copilot\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        19,\n        \"Define how security propagates from data → cube → report\",\n        \"Partial\",\n        \"Copilot can generate security propagation matrix\",\n        \"RBAC, RLS, Policies\",\n        \"GitHub Copilot\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        20,\n        \"Define where business logic resides across ETL, curated layers, and cubes\",\n        \"Partial\",\n        \"Copilot can help separate technical vs business logic\",\n        \"SQL, Spark,Synapse, Databricks, Fabric\",\n        \"GitHub Copilot\",\n        \"\",\n        \"\"\n      ]\n    ]\n  },\n  \"102\": {\n    \"title\": \"Requirement Gathering\",\n    \"columns\": [\n      \"User Story Category\",\n      \"Task Id\",\n      \"Task\",\n      \"Can it be done using Automation/Copilot?\",\n      \"Comments\",\n      \"Technology\",\n      \"Tools\",\n      \"How to Do?\",\n      \"Story Points\"\n    ],\n    \"userStories\": [\n      {\n        \"title\": \"Establish source system inventory, ownership & SLAs\",\n        \"taskIds\": [\n          1,\n          2,\n          3\n        ]\n      },\n      {\n        \"title\": \"Profile source data & define data quality rules\",\n        \"taskIds\": [\n          4\n        ]\n      },\n      {\n        \"title\": \"Define business definitions, KPIs & standardization rules\",\n        \"taskIds\": [\n          5\n        ]\n      },\n      {\n        \"title\": \"Document source‑to‑raw mappings and downstream SLAs\",\n        \"taskIds\": [\n          6\n        ]\n      },\n      {\n        \"title\": \"Document risks, assumptions & analysis acceptance criteria\",\n        \"taskIds\": [\n          7\n        ]\n      },\n      {\n        \"title\": \"Define integration points & system dependencies\",\n        \"taskIds\": [\n          8\n        ]\n      },\n      {\n        \"title\": \"Define & prioritize business requirements\",\n        \"taskIds\": [\n          9\n        ]\n      },\n      {\n        \"title\": \"Define reporting, analytics & exploration requirements\",\n        \"taskIds\": [\n          10\n        ]\n      },\n      {\n        \"title\": \"Define alerting, monitoring & escalation requirements\",\n        \"taskIds\": [\n          11\n        ]\n      },\n      {\n        \"title\": \"Define infrastructure & platform requirements\",\n        \"taskIds\": [\n          12\n        ]\n      },\n      {\n        \"title\": \"Define disaster recovery & rollback strategy\",\n        \"taskIds\": [\n          13\n        ]\n      },\n      {\n        \"title\": \"Define project timeline, milestones & delivery plan\",\n        \"taskIds\": [\n          14\n        ]\n      },\n      {\n        \"title\": \"Define data lifecycle expectations\",\n        \"taskIds\": [\n          15\n        ]\n      },\n      {\n        \"title\": \"Define late data handling expectations\",\n        \"taskIds\": [\n          16\n        ]\n      },\n      {\n        \"title\": \"Define schema evolution expectations\",\n        \"taskIds\": [\n          17\n        ]\n      },\n      {\n        \"title\": \"Define access control needs\",\n        \"taskIds\": [\n          18\n        ]\n      }\n    ],\n    \"rows\": [\n      [\n        \"\",\n        1,\n        \"Create an inventory list of all upstream source systems\",\n        \"No\",\n        \"Copilot can generate inventory templates and consolidate metadata but requires SME validation\",\n        \"SQL Server, ADLS, SharePoint, Excel, APIs, Shortcut, Blob\",\n        \"\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        2,\n        \"Document source system ownership & SME contacts\",\n        \"No\",\n        \"Requires organizational knowledge and stakeholder confirmation\",\n        \"Azure DevOps\",\n        \"\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        3,\n        \"Capture source system SLAs, refresh frequency & data availability windows\",\n        \"No\",\n        \"Copilot can draft SLA documentation from notes but inputs must come from SMEs\",\n        \"Azure DevOps\",\n        \"\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        4,\n        \"Create inventory of all source objects (volume, keys, dependencies)\",\n        \"Partial\",\n        \"Copilot can generate SQL scripts to extract metadata and dependencies\",\n        \"Azure DevOps\",\n        \"GitHub Copilot\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        5,\n        \"Create/Capture business definitions, KPIs & metric glossary\",\n        \"Partial\",\n        \"Copilot drafts definitions but business validation required\",\n        \"Azure Devops, Excel, Sharepoint\",\n        \"Power BI MCP\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        6,\n        \"Create source‑to‑raw mapping document\",\n        \"Partial\",\n        \"Copilot generates mapping templates\",\n        \"Azure Devops, Excel, Sharepoint\",\n        \"GitHub Copilot\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        7,\n        \"Define acceptance criteria for completing analysis phase\",\n        \"Partial\",\n        \"Copilot generates template acceptance criteria\",\n        \"Azure DevOps Work Items (Acceptance Criteria)\",\n        \"\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        8,\n        \"Identify Integration points with existing systems\",\n        \"No\",\n        \"Requires business domain expertise to determine impact.\",\n        \"Fabric, Synapse, Databricks, Power BI\",\n        \"\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        9,\n        \"Prioritize requirements based on business value\",\n        \"No\",\n        \"Requires strategic decission\",\n        \"Fabric, Synapse, Databricks, Power BI, ADF\",\n        \"\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        10,\n        \"Capture ad-hoc querying and exploration needs\",\n        \"No\",\n        \"\",\n        \"Fabric, Synapse, Databricks, Tabular models\",\n        \"\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        11,\n        \"Identify alert escalation  logic\",\n        \"No\",\n        \"\",\n        \"ADF, Databricks, Fabric, Synapse\",\n        \"\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        12,\n        \"Gather subscription, workspace, repository related requirements.\",\n        \"No\",\n        \"\",\n        \"Azure DevOps, Databricks, Fabric, Synapse, ADF\",\n        \"\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        13,\n        \"Identify rollback and disaster recovery requirements\",\n        \"Partial\",\n        \"Copilot provides suggestion on mechanisms\",\n        \"Azure DevOps, Databricks, Fabric, Synapse, ADF\",\n        \"Github Copilot\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        14,\n        \"Capture project timeline and milestone expectations\",\n        \"No\",\n        \"\",\n        \"Azure DevOps, Databricks, Fabric, Synapse, ADF\",\n        \"\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        15,\n        \"Capture data retention, archival, and purge expectations\",\n        \"No\",\n        \"Copilot can document lifecycle policies once defined by business\",\n        \"\",\n        \"\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        16,\n        \"Capture expectations for late‑arriving and corrected data\",\n        \"No\",\n        \"Copilot can capture and format tolerance rules but cannot decide business behavior\",\n        \"\",\n        \"\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        17,\n        \"Capture expectations for handling source schema changes\",\n        \"No\",\n        \"Copilot can help document change expectations and communication rules\",\n        \"\",\n        \"\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        18,\n        \"Capture role‑based access and data sharing expectations\",\n        \"No\",\n        \"Copilot can generate RBAC requirement documentation\",\n        \"\",\n        \"\",\n        \"\",\n        \"\"\n      ]\n    ]\n  },\n  \"103\": {\n    \"title\": \"Analysis\",\n    \"columns\": [\n      \"User Story Category\",\n      \"Task Id\",\n      \"Task\",\n      \"Can it be done using Automation/Copilot?\",\n      \"Comments\",\n      \"Technology\",\n      \"Tools\",\n      \"How to Do?\",\n      \"Story Points\"\n    ],\n    \"userStories\": [\n      {\n        \"title\": \"Define data sensitivity, compliance & retention policies\",\n        \"taskIds\": [\n          1,\n          21\n        ]\n      },\n      {\n        \"title\": \"Define SCD and surrogate key strategy\",\n        \"taskIds\": [\n          2,\n          3,\n          4\n        ]\n      },\n      {\n        \"title\": \"Document risks, assumptions & analysis acceptance criteria\",\n        \"taskIds\": [\n          5,\n          10,\n          11\n        ]\n      },\n      {\n        \"title\": \"Produce consolidated data analysis summary\",\n        \"taskIds\": [\n          6\n        ]\n      },\n      {\n        \"title\": \"Design analytics dimensional model, grain & measures\",\n        \"taskIds\": [\n          7,\n          8\n        ]\n      },\n      {\n        \"title\": \"Define report layout, UX and user personas\",\n        \"taskIds\": [\n          9\n        ]\n      },\n      {\n        \"title\": \"Analyze data quality & root cause issues\",\n        \"taskIds\": [\n          12,\n          13\n        ]\n      },\n      {\n        \"title\": \"Define compute sizing & processing cadence\",\n        \"taskIds\": [\n          14,\n          15,\n          22\n        ]\n      },\n      {\n        \"title\": \"Define data storage, partitioning & performance strategy\",\n        \"taskIds\": [\n          16,\n          17\n        ]\n      },\n      {\n        \"title\": \"Define security, access control & authentication flows\",\n        \"taskIds\": [\n          18\n        ]\n      },\n      {\n        \"title\": \"Define state management & API contracts\",\n        \"taskIds\": [\n          19,\n          23\n        ]\n      },\n      {\n        \"title\": \"Define telemetry, monitoring & observability strategy\",\n        \"taskIds\": [\n          20\n        ]\n      },\n      {\n        \"title\": \"Define data lineage & end‑to‑end dependency graph\",\n        \"taskIds\": [\n          24\n        ]\n      },\n      {\n        \"title\": \"Resolve many‑to‑many relationships & bridge strategy\",\n        \"taskIds\": [\n          25\n        ]\n      },\n      {\n        \"title\": \"Analyze schema drift & compatibility strategy\",\n        \"taskIds\": [\n          26\n        ]\n      },\n      {\n        \"title\": \"Analyze semantic model optimization approach\",\n        \"taskIds\": [\n          27\n        ]\n      }\n    ],\n    \"rows\": [\n      [\n        \"\",\n        1,\n        \"Identify data sensitivity & compliance classifications\",\n        \"No\",\n        \"Compliance classification requires governance and legal decisions\",\n        \"Azure DevOps\",\n        \"\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        2,\n        \"Analyze slowly changing attributes and determine SCD type\",\n        \"Partial\",\n        \"Copilot suggests SCD patterns, but SME decision is required\",\n        \"Databricks, Synapse, Fabric\",\n        \"GitHub Copilot\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        3,\n        \"Create transformation logic inventory & SCD strategy\",\n        \"Partial\",\n        \"Copilot helps document transformation patterns\",\n        \"Databricks, Synapse, Fabric\",\n        \"GitHub Copilot\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        4,\n        \"Identify surrogate key strategy & uniqueness rules\",\n        \"Yes\",\n        \"Copilot suggests approaches but architecture decision required\",\n        \"Databricks, Synapse, Fabric, SQL\",\n        \"GitHub Copilot\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        5,\n        \"Document risks, assumptions & dependencies\",\n        \"Partial\",\n        \"Copilot helps with templates\",\n        \"Azure DevOps\",\n        \"\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        6,\n        \"Create consolidated summary document of all analysis findings\",\n        \"Yes\",\n        \"Copilot generates executive summary documents\",\n        \"OneNote, Azure DevOps\",\n        \"GitHub Copilot\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        7,\n        \"Define the grain of each Fact table\",\n        \"No\",\n        \"Business decision\",\n        \"Power BI, Fabric Semantic Model\",\n        \"\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        8,\n        \"Define all business measures & KPIs\",\n        \"No\",\n        \"Business owned\",\n        \"Power BI, Fabric Semantic Model\",\n        \"\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        9,\n        \"Define user roles & personas (executive, manager, analyst, operational user)\",\n        \"No\",\n        \"Business decision\",\n        \"Power BI Desktop, Tabular Model\",\n        \"\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        10,\n        \"Assess data migration complexity and risks\",\n        \"Partial\",\n        \"Copilot Suggest patterns\",\n        \"Fabric, Synapse, Databricks\",\n        \"GitHub Copilot\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        11,\n        \"Interpret business impact of technical decisions\",\n        \"No\",\n        \"Requires business understanding\",\n        \"\",\n        \"\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        12,\n        \"Analyze root causes of data quality issues\",\n        \"No\",\n        \"Requires investigative analysis\",\n        \"\",\n        \"\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        13,\n        \"Perform dependency analysis across pipelines, notebooks and reports\",\n        \"Yes\",\n        \"Copilot helps in finding lineage\",\n        \"\",\n        \"\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        14,\n        \"Analyze cluster sizing and autoscaling effectiveness\",\n        \"Yes\",\n        \"Copilot analyzes cluster metrics\",\n        \"\",\n        \"\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        15,\n        \"Evaluate data ingestion latency requirements to determine the optimal processing cadence (Real-time vs. Micro-batch) for each business use case.\",\n        \"No\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        16,\n        \"Documenting Assess data partitioning and indexing strategies\",\n        \"Yes\",\n        \"Copilot drafts the document\",\n        \"\",\n        \"\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        17,\n        \"Determine optimal file partitioning keys to minimize data scanning and improve query performance in the data lake.\",\n        \"Partial\",\n        \"\",\n        \"\",\n        \"Github Copilot\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        18,\n        \"Map authentication and authorization flows to define Role-Based Access Control (RBAC) levels for various user personas across the application stack.\",\n        \"Yes\",\n        \"Copliot can help in implementing rolebase access in application for differenct perspective\",\n        \"\",\n        \"GitHub Copilot\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        19,\n        \"Analyze state management requirements to determine if a global store (e.g., Redux, Zustand) or local component state is most efficient for data consistency.\",\n        \"Yes\",\n        \"Copliot can help in implementing the  optimized logic for state management\",\n        \"\",\n        \"\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        20,\n        \"Define telemetry and event-tracking schemas to capture granular user interactions for product analytics and proactive error monitoring.\",\n        \"Yes\",\n        \"Copliot can help in building the base ldea for implementation\",\n        \"\",\n        \"\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        21,\n        \"Categorize PII and sensitive data elements to apply appropriate masking, hashing, or field-level encryption protocols at rest and in transit.\",\n        \"Yes\",\n        \"Copliot can help in masking the data\",\n        \"\",\n        \"\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        22,\n        \"Perform a query-level cost analysis to identify inefficient SQL or Spark operations that may cause unpredicted spikes in cloud consumption.\",\n        \"Partial\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        23,\n        \"Draft an OpenAPI file to document request and response bodies for a specific endpoint.\",\n        \"Yes\",\n        \"\",\n        \"\",\n        \"\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        24,\n        \"Build end‑to‑end lineage map across source → raw → curated → semantic (tables, pipelines, notebooks, reports)\",\n        \"Partial\",\n        \"Copilot can compile lineage from repo/pipeline artifacts and generate a lineage doc; final validation must be done by engineers/owners\",\n        \"Fabric, Purview, ADO, Docs\",\n        \"\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        25,\n        \"Identify M:M relationships and decide bridge table strategy (grain, keys, handling duplicates)\",\n        \"Partial\",\n        \"Copilot can detect likely M:M patterns from schema and propose options; final approach requires modeling decision\",\n        \"SQL, Fabric, Power BI\",\n        \"GitHub Copilot\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        26,\n        \"Decide how to handle schema drift (additive changes, type changes, breaking changes)\",\n        \"Partial\",\n        \"Copilot can recommend drift policies and generate checks; enforcement choice is team decision\",\n        \"Fabric, Spark, ADLS\",\n        \"GitHub Copilot\",\n        \"\",\n        \"\"\n      ],\n      [\n        \"\",\n        27,\n        \"Evaluate need for aggregations, calculation groups, composite models, and query reduction patterns\",\n        \"Partial\",\n        \"Copilot can review model metadata and recommend optimization checklist; must be validated with actual usage/perf\",\n        \"Power BI, Fabric\",\n        \"\",\n        \"\",\n        \"\"\n      ]\n    ]\n  },\n  \"104\": {\n    \"title\": \"Design\",\n    \"columns\": [\n      \"User Story Category\",\n      \"Task Id\",\n      \"Task\",\n      \"Can it be done using Automation/Copilot?\",\n      \"Comments\",\n      \"Technology\",\n      \"Tools\",\n      \"How to Do?\",\n      \"Story Points\"\n    ],\n    \"userStories\": [\n      {\n        \"title\": \"Document authentication & access control requirements\",\n        \"taskIds\": [\n          1\n        ]\n      },\n      {\n        \"title\": \"Define business definitions, KPIs & standardization rules\",\n        \"taskIds\": [\n          2\n        ]\n      },\n      {\n        \"title\": \"Design conceptual data model, subject areas & grain\",\n        \"ta
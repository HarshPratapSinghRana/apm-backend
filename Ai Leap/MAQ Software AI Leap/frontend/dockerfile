# Stage 1: Build Stage
FROM node:20-alpine AS builder

# Set the working directory
WORKDIR /app

# ── Build-time configuration ──────────────────────────────────────────────────
# Vite resolves `import.meta.env.VITE_*` at BUILD TIME, so these must be
# supplied to `docker build` and promoted to ENV before `npm run build` runs.
#
# Usage:
#   docker build \
#     --build-arg VITE_MSAL_CLIENT_ID=<guid> \
#     --build-arg VITE_MSAL_TENANT_ID=<guid> \
#     --build-arg VITE_MSAL_REDIRECT_URI=https://your-app.example.com \
#     --build-arg VITE_ALLOWED_EMAIL_DOMAIN=yourcompany.com \
#     -t frontend .
#
# In a CI/CD pipeline, pull these values from your secret store and pass them
# as --build-arg. NEVER commit a .env.local with real values into the image
# (.dockerignore excludes it as defence in depth).
ARG VITE_MSAL_CLIENT_ID
ARG VITE_MSAL_TENANT_ID
ARG VITE_MSAL_REDIRECT_URI
ARG VITE_ALLOWED_EMAIL_DOMAIN

ENV VITE_MSAL_CLIENT_ID=${VITE_MSAL_CLIENT_ID}
ENV VITE_MSAL_TENANT_ID=${VITE_MSAL_TENANT_ID}
ENV VITE_MSAL_REDIRECT_URI=${VITE_MSAL_REDIRECT_URI}
ENV VITE_ALLOWED_EMAIL_DOMAIN=${VITE_ALLOWED_EMAIL_DOMAIN}

# Copy package configurations to install dependencies first (Docker cache layer optimization)
COPY package*.json ./

# Install packages
RUN npm install

# Copy all source files
COPY . .

# Build the project.
# Note: Based on vite.config.ts, the output directory is configured as `../backend/templates`.
# Within the /app working directory context, this outputs directly to `/backend/templates`.
RUN npm run build

# Stage 2: Production Serving Stage
FROM nginx:alpine

# Remove default Nginx static assets
RUN rm -rf /usr/share/nginx/html/*

# Copy the custom Nginx configuration tailored for the SPA and backend proxy
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy the built React app from the builder stage
# We pull from `/backend/templates` since that's where Vite drops the optimized bundle
COPY --from=builder /backend/templates /usr/share/nginx/html

# Expose port 80 to the outside
EXPOSE 80

# Keep Nginx running in the foreground
CMD ["nginx", "-g", "daemon off;"]

